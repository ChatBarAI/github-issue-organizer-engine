<% content_for :title, "Edit timeline ##{@timeline.id} · GitHub Issue Organizer" %>

<div class="github-issue-organizer-engine" data-unavailability-editor data-timeline-issue-editor>
  <header class="tif-heading tif-timeline-heading">
    <h1 title="Drop into empty time to place an issue without shifting other work. Drop onto another issue to reorder the queue, or onto another developer’s row to reassign. For keyboard controls, focus an issue and press Alt + Shift + an arrow key.">Edit timeline #<%= @timeline.id %></h1>
    <div class="tif-timeline-heading-meta">
      <p>
        <span class="tif-timeline-status is-<%= @timeline.status %>"><%= timeline_status_label(@timeline) %></span> ·
        created by <%= timeline_user_name(@timeline.created_by, @timeline.created_by_id) %>
        on <%= l @timeline.original_created_at, format: :long %>
        <% if @timeline.edited_by_id.present? %>
          · edited by <%= timeline_user_name(@timeline.edited_by, @timeline.edited_by_id) %>
          on <%= l @timeline.created_at, format: :long %>
        <% end %>
        <% if @timeline.source_timeline_id.present? %>
          · revision of Timeline #<%= @timeline.source_timeline_id %>
        <% end %>
        · Drag issues to reorder a developer's work or move it directly to another developer.
      </p>
      <% if @timeline.items.any? %>
        <label class="tif-switch" title="Make Saturday and Sunday narrower to show more days">
          <input type="checkbox"
            role="switch"
            data-compact-weekends-toggle
            data-timeline-chart-target="tif-updated-schedule-chart">
          <span class="tif-switch-control" aria-hidden="true"></span>
          <span class="tif-switch-label">Compact weekends</span>
        </label>
      <% end %>
    </div>
    <nav class="tif-heading-links" aria-label="Timeline navigation">
      <% if @timeline.draft? %>
        <%= button_to "Set as current",
          make_current_timeline_path(@timeline),
          method: :patch,
          class: "tif-account-link",
          form: { data: { turbo_confirm: "Set this draft as the current timeline? The existing current timeline will become obsolete." } } %>
      <% end %>
      <%= link_to "View timeline", timeline_path(@timeline), class: "tif-account-link" %>
      <%= link_to "All timelines", timelines_path, class: "tif-account-link" %>
    </nav>
  </header>

  <section class="tif-panel tif-editor-section tif-unavailability-section">
    <div class="tif-editor-section-heading">
      <h2>Unavailable time</h2>
      <button type="button"
        class="tif-account-link"
        data-open-add-unavailability-dialog
        aria-haspopup="dialog"
        aria-controls="tif-add-unavailability-dialog">
        Add
      </button>
    </div>
    <% displayed_periods, outside_periods = @timeline.unavailabilities.select(&:persisted?).partition do |period|
      unavailability_in_displayed_timeline?(period, @timeline, past_days: @extra_past_days)
    end %>
    <%= render "unavailability_list", timeline: @timeline, periods: displayed_periods if displayed_periods.any? %>
    <% if outside_periods.any? %>
      <details class="tif-outside-unavailability">
        <summary>Outside displayed dates (<%= outside_periods.size %>)</summary>
        <%= render "unavailability_list", timeline: @timeline, periods: outside_periods %>
      </details>
    <% end %>
    <p class="tif-unavailability-selection-prompt"
      data-unavailability-selection-prompt
      role="status"
      aria-live="polite"
      hidden>
      Click a position in the timeline to choose the developer and start time.
    </p>
  </section>

  <section class="tif-panel tif-editor-section" aria-labelledby="tif-updated-schedule-title">
    <h2 id="tif-updated-schedule-title" class="tif-visually-hidden">Updated schedule</h2>
    <div class="tif-move-feedback" data-timeline-issue-move-status hidden>
      <span class="tif-move-feedback-icon" data-move-status-icon aria-hidden="true">i</span>
      <div class="tif-move-feedback-copy" role="status" aria-live="polite" aria-atomic="true">
        <strong data-move-status-title></strong>
        <span data-move-status-message></span>
      </div>
      <button type="button" class="tif-move-feedback-dismiss" data-dismiss-move-status aria-label="Dismiss move message">×</button>
    </div>
    <%= render "chart",
      timeline: @timeline,
      editable_unavailability: true,
      editable_issues: true,
      extra_past_days: @extra_past_days,
      show_view_options: false,
      chart_id: "tif-updated-schedule-chart" %>
    <%= render "informational_issues", timeline: @timeline %>
  </section>

  <dialog id="tif-fill-gaps-dialog" aria-labelledby="tif-fill-gaps-title">
    <div class="tif-dialog-header">
      <h2 id="tif-fill-gaps-title">Fill gaps from <span data-fill-gaps-label></span></h2>
      <button type="button" class="tif-dialog-close" data-close-fill-gaps aria-label="Close dialog">×</button>
    </div>
    <p>Move issues starting on or after this date earlier across all developer rows, keeping their developer and queue order. Earlier issues stay in place. Weekends and unavailable time are respected.</p>
    <%= form_with url: fill_gaps_timeline_path(@timeline), method: :patch do %>
      <%= hidden_field_tag :from_date, nil, data: { fill_gaps_input: true } %>
      <%= hidden_field_tag :extra_past_days, @extra_past_days %>
      <div class="tif-dialog-actions">
        <button type="button" class="tif-account-link" data-close-fill-gaps>Cancel</button>
        <%= submit_tag "Fill gaps from this date", class: "tif-primary" %>
      </div>
    <% end %>
  </dialog>

  <dialog id="tif-past-days-dialog" aria-labelledby="tif-past-days-title">
    <div class="tif-dialog-header">
      <h2 id="tif-past-days-title">Show past days</h2>
      <button type="button" class="tif-dialog-close" data-close-past-days
        aria-label="Close dialog">×</button>
    </div>
    <%= form_with url: edit_timeline_path(@timeline), method: :get do |form| %>
      <div class="tif-field">
        <%= form.label :extra_past_days, "Days before Timeline start" %>
        <%= form.number_field :extra_past_days, value: @extra_past_days, min: 0, max: 365, step: 1, required: true %>
      </div>
      <div class="tif-dialog-actions">
        <button type="button" class="tif-account-link" data-close-past-days>Cancel</button>
        <%= form.submit "Update display", class: "tif-primary" %>
      </div>
    <% end %>
  </dialog>

  <%= render "add_unavailability_dialog", timeline: @timeline, unavailability: @unavailability %>
  <%= render "unavailability_dialog", timeline: @timeline %>
</div>
