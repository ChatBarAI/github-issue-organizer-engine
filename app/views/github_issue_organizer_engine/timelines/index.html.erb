<% content_for :title, "Saved timelines · Team Issue Finder" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "github_issue_organizer_engine/application", "data-turbo-track": "reload" %>
<% end %>

<div class="github-issue-organizer-engine">
  <header class="tif-heading">
    <div>
      <h1>Timelines</h1>
      <p>Generated issue schedules shared by authorized users. The current timeline is shown first.</p>
    </div>
    <nav class="tif-heading-links" aria-label="Timeline actions">
      <% if @timelines.any?(&:draft?) %>
        <%= button_to "Delete all drafts",
          destroy_drafts_timelines_path,
          method: :delete,
          class: "tif-account-link tif-danger-button",
          form: { data: { turbo_confirm: "Delete all draft timelines? This cannot be undone." } } %>
      <% end %>
      <%= link_to "New draft", root_path, class: "tif-account-link" %>
    </nav>
  </header>

  <section class="tif-panel">
    <% if @timelines.any? %>
      <div class="tif-saved-list">
        <% @timeline_rows.each do |row| %>
          <% timeline = row.timeline %>
          <article class="tif-saved-item <%= "is-earlier-revision" if row.depth.positive? %>"
            style="--tif-revision-indent: <%= row.depth * 24 %>px; --tif-revision-connector-left: <%= 15 + ([row.depth - 1, 0].max * 24) %>px">
            <div>
              <h2>
                <%= link_to compact_date_range(timeline.starts_on, timeline.ends_on || timeline.starts_on), timeline_path(timeline) %>
                <span class="tif-timeline-status is-<%= timeline.status %>"><%= timeline_status_label(timeline) %></span>
              </h2>
              <p>
                Timeline #<%= timeline.id %> ·
                <%= pluralize timeline.developer_ids.size, "developer" %> ·
                <%= pluralize timeline.items.size, "scheduled issue" %> ·
                created by <%= timeline_user_name(timeline.created_by, timeline.created_by_id) %>
                on <%= l timeline.original_created_at, format: :long %>
                <% if timeline.edited_by_id.present? %>
                  · edited by <%= timeline_user_name(timeline.edited_by, timeline.edited_by_id) %>
                  on <%= l timeline.created_at, format: :long %>
                <% end %>
                <% if timeline.source_timeline_id.present? %>
                  · revision of Timeline #<%= timeline.source_timeline_id %>
                <% end %>
              </p>
            </div>
            <div class="tif-saved-item-actions">
              <% if timeline.draft? %>
                <%= button_to "Set as current",
                  make_current_timeline_path(timeline),
                  method: :patch,
                  class: "tif-account-link",
                  form: { data: { turbo_confirm: "Set this draft as the current timeline? The existing current timeline will become obsolete." } } %>
              <% end %>
              <%= button_to "×",
                timeline_path(timeline),
                method: :delete,
                class: "tif-icon-danger-button",
                title: "Delete timeline",
                aria: { label: "Delete timeline ##{timeline.id}" },
                form: { data: { turbo_confirm: "Delete this timeline?" } } %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="tif-help">No timelines have been generated yet.</p>
    <% end %>
  </section>
</div>
