<section class="tif-panel tif-issue-history">
  <h2 title="All open issues across configured repositories, recorded whenever a timeline becomes current.">Open issues over time</h2>
  <% if snapshots.empty? %>
    <p class="tif-help">Set a draft as current to record the first snapshot.</p>
  <% else %>
    <% series = issue_history_series(snapshots) %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 310" role="img" aria-labelledby="issue-history-title issue-history-description" class="tif-issue-history-chart">
      <title id="issue-history-title">Open issues over time by priority</title>
      <desc id="issue-history-description">Counts at each timeline activation. Exact counts and repositories are listed in the snapshot history below.</desc>
      <% maximum = [snapshots.map(&:total).max, 1].max %>
      <% [0, (maximum / 2.0).ceil, maximum].uniq.each do |count| %>
        <% y = 260 - 220.0 * count / maximum %>
        <line x1="60" y1="<%= y %>" x2="820" y2="<%= y %>" stroke="currentColor" opacity="0.15" />
        <text x="48" y="<%= y + 5 %>" text-anchor="end" fill="currentColor" font-size="14"><%= count %></text>
      <% end %>
      <% series.each do |entry| %>
        <polyline points="<%= entry[:points].map { |point| "#{point[:x]},#{point[:y]}" }.join(' ') %>" fill="none" stroke="<%= entry[:color] %>" stroke-width="<%= entry[:label] == 'Total' ? 3 : 2 %>" />
        <% entry[:points].each do |point| %>
          <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="4" fill="<%= entry[:color] %>">
            <title><%= entry[:label] %>: <%= point[:count] %> · <%= l point[:captured_at], format: :long %></title>
          </circle>
        <% end %>
      <% end %>
      <text x="60" y="292" fill="currentColor" font-size="14"><%= l snapshots.first.captured_at, format: :short %></text>
      <% if snapshots.size > 1 %>
        <text x="820" y="292" text-anchor="end" fill="currentColor" font-size="14"><%= l snapshots.last.captured_at, format: :short %></text>
      <% end %>
    </svg>
    <ul class="tif-issue-history-legend" aria-label="Chart legend">
      <% series.each do |entry| %>
        <li><span style="background: <%= entry[:color] %>" aria-hidden="true"></span><%= entry[:label] %></li>
      <% end %>
    </ul>
    <details>
      <summary>Snapshot history and exact counts</summary>
      <div class="tif-issue-history-table">
        <table>
          <thead><tr><th scope="col">Recorded</th><th scope="col">Repositories</th><% series.each do |entry| %><th scope="col"><%= entry[:label] %></th><% end %></tr></thead>
          <tbody>
            <% snapshots.reverse_each do |snapshot| %>
              <tr>
                <th scope="row"><%= l snapshot.captured_at, format: :long %></th>
                <td><%= snapshot.repositories.join(', ') %></td>
                <td><%= snapshot.total %></td>
                <% GithubIssueOrganizerEngine::IssuePriorityCounts::PRIORITIES.each do |priority| %><td><%= snapshot.priority_counts.fetch(priority, 0) %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% end %>
</section>
